10 REM PONG - DU SPIELST LINKS GEGEN DEN COMPUTER
20 REM STEUERUNG: STEUERKREUZ HOCH/RUNTER ODER W/S
30 REM WER ZUERST 7 PUNKTE HAT, GEWINNT
40 CLS: GCLS: SPROFF
50 RECT 0,0,255,191,1
60 FOR Y=6 TO 186 STEP 12: LINE 128,Y,128,Y+5,11: NEXT
70 PY=80: CY=80: P1=0: P2=0
80 GOSUB 500
100 REM --- HAUPTSCHLEIFE ---
110 J=JOY: K$=INKEY$
120 IF (J AND 1) OR K$="W" THEN PY=PY-4
130 IF (J AND 2) OR K$="S" THEN PY=PY+4
140 IF PY<2 THEN PY=2
150 IF PY>166 THEN PY=166
160 IF CY+12<BY THEN CY=CY+3
170 IF CY+12>BY+4 THEN CY=CY-3
180 IF CY<2 THEN CY=2
190 IF CY>166 THEN CY=166
200 BX=BX+DX: BY=BY+DY
210 IF BY<2 THEN BY=2: DY=-DY: SOUND 1
220 IF BY>182 THEN BY=182: DY=-DY: SOUND 1
230 IF DX<0 AND BX<=16 AND BX>=4 AND BY+8>=PY AND BY<=PY+24 THEN DX=-DX+0.2: DY=(BY-PY-8)/4: SOUND 0
240 IF DX>0 AND BX>=232 AND BX<=244 AND BY+8>=CY AND BY<=CY+24 THEN DX=-DX-0.2: DY=(BY-CY-8)/4: SOUND 0
250 IF BX<-8 THEN P2=P2+1: SOUND 2: GOSUB 500
260 IF BX>256 THEN P1=P1+1: SOUND 2: GOSUB 500
270 FOR I=0 TO 2: SPRITE I,0,8,PY+I*8: SPRITE 3+I,0,240,CY+I*8: NEXT
280 SPRITE 6,1,BX,BY
290 PAUSE 1
300 IF P1<7 AND P2<7 THEN 110
310 SPROFF 6
320 IF P1=7 THEN LOCATE 11,10: PRINT "DU GEWINNST!" ELSE LOCATE 11,8: PRINT "COMPUTER GEWINNT"
330 END
500 REM --- PUNKTE ANZEIGEN, NEUER BALL ---
510 LOCATE 1,11: PRINT P1;: LOCATE 1,17: PRINT P2;
520 BX=124: BY=92: DX=2.5: IF RND(1)<0.5 THEN DX=-2.5
530 DY=RND(1)*3-1.5
540 SPRITE 6,1,BX,BY: PAUSE 40
550 RETURN
