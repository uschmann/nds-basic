10 REM SNAKE - FRISS DIE AEPFEL, BEISS DICH NICHT SELBST
20 REM STEUERUNG: STEUERKREUZ ODER W/A/S/D
30 CLS: GCLS: SPROFF
40 DIM G(31,23), SX(767), SY(767)
50 RECT 0,8,255,15,5,1: RECT 0,184,255,191,5,1
60 RECT 0,8,7,191,5,1: RECT 248,8,255,191,5,1
70 LOCATE 0,0: PRINT "SNAKE      PUNKTE: 0"
80 L=3: H=2: T=0: NX=1: NY=0: P=0: SP=8
90 FOR I=0 TO 2: SX(I)=10+I: SY(I)=12: G(10+I,12)=1: STAMP 4,(10+I)*8,96: NEXT
95 SPRITE 1,3,96,96
100 GOSUB 400
110 REM --- HAUPTSCHLEIFE: SP FRAMES WARTEN, DABEI EINGABE LESEN ---
120 FOR W=1 TO SP: GOSUB 300: PAUSE 1: NEXT
130 DX=NX: DY=NY
140 X=SX(H)+DX: Y=SY(H)+DY
150 IF X<1 OR X>30 OR Y<2 OR Y>22 THEN 600
160 IF G(X,Y) THEN 600
170 H=(H+1) MOD 768: SX(H)=X: SY(H)=Y: G(X,Y)=1
180 STAMP 4,X*8,Y*8: SPRITE 1,3,X*8,Y*8
190 IF X=FX AND Y=FY THEN GOSUB 450
200 N=(H-T+768) MOD 768+1
210 IF N>L THEN RECT SX(T)*8,SY(T)*8,SX(T)*8+7,SY(T)*8+7,-1,1: G(SX(T),SY(T))=0: T=(T+1) MOD 768
220 GOTO 120
300 REM --- EINGABE (KEINE UMKEHR AUF DER STELLE) ---
310 J=JOY: K$=INKEY$
320 IF ((J AND 1) OR K$="W") AND DY=0 THEN NX=0: NY=-1
330 IF ((J AND 2) OR K$="S") AND DY=0 THEN NX=0: NY=1
340 IF ((J AND 4) OR K$="A") AND DX=0 THEN NX=-1: NY=0
350 IF ((J AND 8) OR K$="D") AND DX=0 THEN NX=1: NY=0
360 RETURN
400 REM --- NEUER APFEL AN FREIER STELLE ---
410 FX=INT(RND(1)*30)+1: FY=INT(RND(1)*21)+2
420 IF G(FX,FY) THEN 410
430 SPRITE 0,2,FX*8,FY*8
440 RETURN
450 REM --- APFEL GEFRESSEN ---
460 P=P+10: L=L+1: SOUND 0
470 LOCATE 0,18: PRINT P;
480 IF SP>3 AND L MOD 4=0 THEN SP=SP-1
490 GOSUB 400: RETURN
600 REM --- GAME OVER ---
610 SOUND 1
620 LOCATE 10,11: PRINT "GAME OVER"
630 LOCATE 12,9: PRINT "PUNKTE:";P
640 END
