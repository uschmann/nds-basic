100 REM count pixels of colour C in box 0..63
110 GOTO 1000
200 N=0: FOR Y=0 TO 63: FOR X=0 TO 63: IF POINT(X,Y)=C THEN N=N+1
210 NEXT X, Y: RETURN
1000 LINE 0,0,9,0,3: C=3: GOSUB 200: PRINT "LINE";N
1010 GCLS: RECT 0,0,9,9,4,1: C=4: GOSUB 200: PRINT "BOX";N
1020 GCLS: RECT 10,10,19,19,5: C=5: GOSUB 200: PRINT "RECT";N
1030 PAINT 15,15,5: GOSUB 200: PRINT "PAINT";N
1040 GCLS: CIRCLE 30,30,10,7,1: C=7: GOSUB 200: PRINT "DISC";N
1050 GCLS: GCOLOR 2: PLOT 5,5: PRINT "PLOT";POINT(5,5);POINT(6,6);POINT(-1,0)
1060 PLOT 5,5,-1: PRINT "ERASE";POINT(5,5)
1070 CIRCLE 300,300,5: LINE -10,-10,500,500: PRINT "CLIP OK"
1080 PLOT 1,1,16
